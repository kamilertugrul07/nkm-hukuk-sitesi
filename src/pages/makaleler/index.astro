---
import Base from '../../layouts/Base.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getArticles } from '../../lib/articles';

const articles = await getArticles();
const [featured] = articles;
const areas = [...new Set(articles.map((a) => a.data.area))];
---
<Base
  title="Makaleler · NKM Hukuk Bürosu"
  description="İcra, aile, ceza, iş, gayrimenkul, yabancılar, kat mülkiyeti ile trafik kazası ve sigorta hukukunda sık sorulan sorulara anlaşılır yanıtlar."
>
  <section class="head wrap">
    <h1 class="display" data-rise>Makaleler</h1>
    <p data-rise style="--i:1">Sık karşılaştığımız hukuki sorulara sade ve anlaşılır yanıtlar. Yazılarımız genel bilgilendirme amaçlıdır.</p>
  </section>

  {featured && (
    <section class="featured wrap" aria-label="Son makale" data-rise>
      <ArticleCard article={featured} large />
    </section>
  )}

  <section class="all wrap" aria-labelledby="all-title">
    <div class="all-head">
      <h2 id="all-title" class="display">Tüm yazılar</h2>
      <div class="filters" role="group" aria-label="Çalışma alanına göre süz">
        <button type="button" class="chip on" data-filter="">Tümü</button>
        {areas.map((a) => <button type="button" class="chip" data-filter={a}>{a}</button>)}
      </div>
    </div>
    <div class="grid3" id="grid">
      {articles.map((a, i) => (
        <div data-rise style={`--i:${i % 3}`} data-featured={i === 0 ? '' : undefined} hidden={i === 0}>
          <ArticleCard article={a} />
        </div>
      ))}
    </div>
    <p class="empty" id="empty" hidden>Bu alanda henüz yazı yok.</p>
  </section>
</Base>

<script>
  // Area filter: hides cards outside the chosen area; without script every card is shown.
  const chips = document.querySelectorAll<HTMLButtonElement>('.chip');
  const cards = document.querySelectorAll<HTMLElement>('#grid > div');
  chips.forEach((chip) => chip.addEventListener('click', () => {
    const area = chip.dataset.filter ?? '';
    chips.forEach((c) => { c.classList.toggle('on', c === chip); c.setAttribute('aria-pressed', String(c === chip)); });
    let shown = 0;
    cards.forEach((card) => {
      // With no filter the featured article is already shown above, so it is left out of the grid.
      const match = area
        ? card.querySelector<HTMLElement>('[data-area]')?.dataset.area === area
        : !card.hasAttribute('data-featured');
      card.hidden = !match;
      if (match) shown++;
    });
    document.querySelector<HTMLElement>('#empty')!.hidden = shown > 0;
  }));
</script>

<style>
  .head { padding-block: clamp(40px, 6vw, 88px) clamp(40px, 5vw, 64px); }
  .head h1 { font-size: var(--step-xl); color: var(--accent); }
  .head p { margin-top: 18px; max-width: 56ch; font-size: 20px; }
  .featured { padding-bottom: clamp(72px, 9vw, 130px); }
  .all { padding-bottom: var(--section-gap); }
  .all-head { display: flex; justify-content: space-between; align-items: end; gap: 24px; flex-wrap: wrap; margin-bottom: 36px; }
  .all-head h2 { font-size: var(--step-l); color: var(--accent); }
  .filters { display: flex; flex-wrap: wrap; gap: 8px; }
  .chip {
    font: 500 16px var(--text); color: var(--ink); background: var(--paper);
    border: 0; border-radius: 0; min-height: 40px; padding: 0 16px; cursor: pointer;
    transition: background-color var(--t-hover) ease, color var(--t-hover) ease;
  }
  .chip.on { background: var(--accent); color: var(--on-accent); }
  @media (hover: hover) and (pointer: fine) { .chip:not(.on):hover { background: var(--surface); } }
  .grid3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 48px 28px; }
  .empty { color: var(--muted); }
  @media (max-width: 1000px) { .grid3 { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 600px) { .grid3 { grid-template-columns: 1fr; } }
</style>
