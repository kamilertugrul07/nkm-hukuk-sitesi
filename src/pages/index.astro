---
import { Image, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { site, attorneys } from '../data/site';
import { getCollection } from 'astro:content';
import { deadlines } from '../data/home';
import heroImg from '../assets/img/hero-masa.png';
import tersane from '../assets/img/tersane.jpg';
import kaleDeniz from '../assets/img/kale-deniz.jpg';
import dilekce from '../assets/img/dilekce.png';
import vekalet from '../assets/img/vekalet.png';
import kitaplar from '../assets/img/kitaplar.png';

const areas = (await getCollection('alanlar')).sort((a, b) => a.data.order - b.data.order);

// Full-bleed backgrounds are set in CSS, so they are optimised here and passed as custom properties.
const heroBg = await getImage({ src: heroImg, width: 2000, format: 'webp', quality: 72 });
const heroBgSm = await getImage({ src: heroImg, width: 900, format: 'webp', quality: 70 });
const contactBg = await getImage({ src: tersane, width: 1800, format: 'webp', quality: 68 });

const panels = [
  { href: '/dilekce-ornekleri', title: 'Dilekçe örnekleri', img: dilekce, alt: 'Masada dolma kalem ve mühür mumu ile boş bir dilekçe kâğıdı', grow: 5 },
  { href: '/vekalet', title: 'Vekalet', img: vekalet, alt: 'Pirinç saplı bir mühür ve kurdeleyle bağlanmış belgeler', grow: 2 },
  { href: '/makaleler', title: 'Makaleler', img: kitaplar, alt: 'Bordo deri ciltli eski hukuk kitapları', grow: 3 },
  { href: '/hakkimizda', title: 'Büro', img: kaleDeniz, alt: 'Alanya Kalesi’nden Akdeniz’e bakış', grow: 2 },
];
---
<Base
  overlay
  title="NKM Hukuk Bürosu · Alanya Avukatlık"
  description="Alanya merkezli, tüm Türkiye'de icra, aile, ceza, iş, gayrimenkul, yabancılar, kat mülkiyeti ile trafik kazası ve sigorta hukukunda avukatlık ve danışmanlık. Ücretsiz dilekçe ve vekaletname örnekleri."
>
  <!-- Hero: full-bleed photograph, bold headline on the dark side -->
  <section class="hero" style={`--bg-lg:url(${heroBg.src});--bg-sm:url(${heroBgSm.src})`} aria-labelledby="hero-title">
    <div class="wrap hero-copy">
      <h1 id="hero-title" class="display" data-rise>Hukuk, ayrıntıların sanatıdır.</h1>
      <p data-rise style="--i:1">İcra, aile, ceza, iş, gayrimenkul, yabancılar, kat mülkiyeti ile trafik kazası ve sigorta hukukunda avukatlık ve danışmanlık.</p>
      <div class="hero-actions" data-rise style="--i:2">
        <a class="button" href="#iletisim">Görüşme talep edin</a>
        <a class="button ghost" href="/dilekce-ornekleri">Ücretsiz dilekçe örnekleri</a>
      </div>
    </div>
  </section>

  <!-- Practice areas: photo cards, the eighth is the call to action -->
  <section class="areas wrap" id="calisma-alanlari" aria-labelledby="areas-title">
    <div class="sec-head">
      <h2 id="areas-title" class="display sec-title" data-rise>Çalışma alanlarımız</h2>
      <p data-rise style="--i:1">Alanya’daki büromuzdan tüm Türkiye’de sekiz alanda avukatlık ve danışmanlık hizmeti veriyoruz.</p>
    </div>
    <ul class="cards">
      {areas.map((a, i) => (
        <li class="card" data-rise style={`--i:${i % 4}`}>
          <a href={`/calisma-alanlari/${a.id}`}>
            <div class="card-ph">
              <Image src={a.data.image} alt={a.data.imageAlt} widths={[360, 540, 720]} sizes="(max-width: 600px) 92vw, (max-width: 1000px) 46vw, 23vw" quality={72} />
            </div>
            <h3 class="display">{a.data.name}</h3>
            <ul class="card-items">{a.data.services.slice(0, 3).map((s) => <li>{s.title}</li>)}</ul>
          </a>
        </li>
      ))}
      <li class="card card-cta" data-rise style="--i:3">
        <h3 class="display">Nereden başlayacağınızı bilmiyor musunuz?</h3>
        <p>Durumunuzu kısaca anlatın; ilk adımı birlikte atalım.</p>
        <a class="button light" href="#iletisim">Randevu alın</a>
      </li>
    </ul>
  </section>

  <!-- Free resources: a band of unequal photo panels -->
  <section class="band-section" id="kaynaklar" aria-labelledby="band-title">
    <div class="wrap sec-head">
      <h2 id="band-title" class="display sec-title" data-rise>Ücretsiz kaynaklar</h2>
      <p data-rise style="--i:1">Sık ihtiyaç duyulan dilekçe ve vekaletname örnekleri, hukuki yazılarımız.</p>
    </div>
    <div class="band">
      {panels.map((p) => (
        <a class="panel" href={p.href} style={`--grow:${p.grow}`}>
          <Image src={p.img} alt={p.alt} widths={[400, 700, 1000]} sizes="(max-width: 700px) 64vw, 42vw" quality={72} />
          <span class="panel-title display">{p.title}</span>
        </a>
      ))}
    </div>
    <p class="band-cap wrap">Örnekler bilgilendirme amaçlıdır; kendi dosyanız için bir avukata danışın.</p>
  </section>

  <!-- Deadline calculator: one process, one large result -->
  <section class="calc wrap" id="sureler" aria-labelledby="calc-title">
    <div class="calc-in">
      <form class="calc-pick" onsubmit="return false">
        <h2 id="calc-title" class="display">Son gününüzü hesaplayın</h2>
        <p>Size gelen tebligatın türünü seçin ve tebliğ tarihini girin.</p>
        <label for="calc-act">İşlem</label>
        <select id="calc-act">
          {deadlines.map((d, i) => <option value={i} data-n={d.n} data-unit={d.unit} data-law={d.law}>{d.act} ({d.label})</option>)}
        </select>
        <label for="calc-date">Tebliğ tarihi</label>
        <input id="calc-date" type="date" required />
      </form>
      <div class="calc-out" aria-live="polite">
        <p class="calc-big display" id="calc-big">Son gün</p>
        <p class="calc-wd" id="calc-wd">Tebliğ tarihini seçtiğinizde son gün burada görünür.</p>
        <p class="calc-left" id="calc-left" hidden></p>
        <p class="calc-law" id="calc-law">
          Hafta sonları hesaba katılır; resmî tatiller ve adli tatil katılmaz. Kesin süre için tebligatı bir avukata gösterin.
        </p>
      </div>
    </div>
  </section>

  <!-- Contact: form over the Alanya shipyard -->
  <section class="contact" id="iletisim" style={`--bg-c:url(${contactBg.src})`} aria-labelledby="contact-title">
    <div class="wrap contact-in">
      <div class="contact-info">
        <h2 id="contact-title" class="display sec-title" data-rise>Bizimle İletişime Geçin</h2>
        <p data-rise style="--i:1">Formu doldurun ya da doğrudan arayın. Büromuzda veya çevrim içi görüşme ayarlayalım.</p>
        <div class="people" data-rise style="--i:2">
          {attorneys.map((a) => (
            <div class="contact-person">
              <p class="cp-name display">{a.name}</p>
              <p><a class="link" href={a.phoneHref}>{a.phone}</a></p>
              <a class="button ghost" href={a.whatsapp}>WhatsApp’tan yazın</a>
            </div>
          ))}
        </div>
        <p class="contact-addr" data-rise style="--i:3">
          <span>E-posta</span>
          <a class="link" href={`mailto:${site.email}`}>{site.email}</a>
        </p>
        <p class="contact-addr" data-rise style="--i:3">
          <span>Adres</span>
          <a class="link" href={site.mapsHref}>{site.address}</a>
        </p>
      </div>
      <form class="cform" id="cform" data-rise style="--i:1">
        <h3 class="display">Randevu Formu</h3>
        <label>Ad soyad<input name="ad" autocomplete="name" required /></label>
        <label>Telefon<input name="telefon" type="tel" autocomplete="tel" required /></label>
        <label class="full">Konu
          <select name="konu">{areas.map((a) => <option>{a.data.name}</option>)}<option>Diğer</option></select>
        </label>
        <label class="full">Mesajınız<textarea name="mesaj" rows="5" required aria-describedby="mesaj-not"></textarea></label>
        <p class="cform-hint full" id="mesaj-not">Sağlık bilgisi, ceza geçmişi gibi özel nitelikli verilerinizi bu forma yazmayın; gerekirse görüşmede konuşalım.</p>
        <label class="kvkk full"><input type="checkbox" name="kvkk" required />
          <span><a class="link" href="/kvkk">KVKK aydınlatma metnini</a> okudum.</span>
        </label>
        <!-- Spam trap: hidden from people, bots tick it. -->
        <input type="checkbox" name="botcheck" class="trap" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <button class="button full" type="submit">Gönder</button>
        <p class="cform-note full" id="cform-note" role="status" hidden></p>
      </form>
    </div>
  </section>
</Base>

<script>
  import { formRecipients } from '../data/site';

  // Deadline calculator: the last day from the notification date, rolled past weekends.
  const act = document.querySelector<HTMLSelectElement>('#calc-act')!;
  const date = document.querySelector<HTMLInputElement>('#calc-date')!;
  const out = {
    big: document.querySelector<HTMLElement>('#calc-big')!,
    wd: document.querySelector<HTMLElement>('#calc-wd')!,
    left: document.querySelector<HTMLElement>('#calc-left')!,
  };
  const fmt = new Intl.DateTimeFormat('tr-TR', { day: 'numeric', month: 'long', year: 'numeric' });
  const weekday = new Intl.DateTimeFormat('tr-TR', { weekday: 'long' });
  const addMonths = (d: Date, n: number) => {
    const r = new Date(d.getFullYear(), d.getMonth() + n, 1);
    r.setDate(Math.min(d.getDate(), new Date(r.getFullYear(), r.getMonth() + 1, 0).getDate()));
    return r;
  };
  const lastDay = (from: Date, n: number, unit: string) => {
    let d = unit === 'a' ? addMonths(from, n)
      : new Date(from.getFullYear(), from.getMonth(), from.getDate() + n * (unit === 'h' ? 7 : 1));
    while (d.getDay() === 0 || d.getDay() === 6) d = new Date(d.getFullYear(), d.getMonth(), d.getDate() + 1);
    return d;
  };
  const render = () => {
    const opt = act.selectedOptions[0];
    if (!date.value) return;
    const [y, m, d] = date.value.split('-').map(Number);
    const end = lastDay(new Date(y, m - 1, d), Number(opt.dataset.n), opt.dataset.unit ?? 'g');
    const today = new Date(); today.setHours(0, 0, 0, 0);
    const days = Math.round((end.getTime() - today.getTime()) / 864e5);
    out.big.textContent = fmt.format(end);
    out.wd.textContent = `${weekday.format(end)}: ${opt.textContent?.replace(/\s*\(.*\)$/, '')} için son gün (${opt.dataset.law})`;
    out.left.hidden = false;
    out.left.textContent = days < 0 ? 'Süre dolmuş görünüyor; hemen bir avukata danışın.'
      : days === 0 ? 'Bugün son gün!' : days <= 3 ? `Son ${days} gün!` : `${days} gün kaldı`;
    out.left.classList.toggle('calm', days > 3);
  };
  act.addEventListener('input', render);
  date.addEventListener('input', render);
  // Start from today so the result panel is never empty.
  const now = new Date();
  date.value = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}-${String(now.getDate()).padStart(2, '0')}`;
  render();

  // Contact form: sent through Web3Forms when a key is configured (PUBLIC_WEB3FORMS_KEY).
  // Without a key, or if the service cannot be reached, the message opens in the visitor's mail app instead.
  const FORM_KEY = import.meta.env.PUBLIC_WEB3FORMS_KEY as string | undefined;
  const form = document.querySelector<HTMLFormElement>('#cform')!;
  const note = document.querySelector<HTMLElement>('#cform-note')!;
  const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
  const say = (text: string) => { note.hidden = false; note.textContent = text; };
  const openMail = (f: FormData) => {
    const body = `Ad soyad: ${f.get('ad')}\nTelefon: ${f.get('telefon')}\nKonu: ${f.get('konu')}\n\n${f.get('mesaj')}`;
    location.href = `mailto:${formRecipients}?subject=${encodeURIComponent(`Randevu talebi: ${f.get('konu')}`)}&body=${encodeURIComponent(body)}`;
  };

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const f = new FormData(form);
    if (f.get('botcheck')) return;
    if (!FORM_KEY) {
      openMail(f);
      say('E-posta uygulamanız açıldı; mesajı göndermeyi unutmayın.');
      return;
    }
    submit.disabled = true;
    submit.textContent = 'Gönderiliyor…';
    try {
      const res = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify({
          access_key: FORM_KEY,
          subject: `Randevu talebi: ${f.get('konu')}`,
          from_name: 'NKM Hukuk Bürosu internet sitesi',
          'Ad soyad': f.get('ad'),
          Telefon: f.get('telefon'),
          Konu: f.get('konu'),
          Mesaj: f.get('mesaj'),
          botcheck: false,
        }),
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok || !data.success) throw new Error(data.message || res.statusText);
      form.reset();
      say('Mesajınız iletildi. En kısa sürede size telefonla dönüş yapacağız.');
      submit.textContent = 'Gönderildi';
    } catch {
      say('Mesaj şu anda gönderilemedi; e-posta uygulamanız açılıyor. Dilerseniz bizi telefonla da arayabilirsiniz.');
      submit.disabled = false;
      submit.textContent = 'Gönder';
      openMail(f);
    }
  });
</script>

<style>
  .sec-head { display: flex; justify-content: space-between; align-items: end; gap: 32px; margin-bottom: 56px; }
  .sec-head p { max-width: 42ch; color: var(--muted); }
  .sec-title { font-size: var(--step-xl); color: var(--accent); }

  /* Hero */
  .hero {
    position: relative; min-height: 100svh; display: flex; align-items: center;
    background: #1d120e var(--bg-lg) center / cover no-repeat; color: var(--bg);
  }
  .hero::before { /* taste-skill-ignore: neutral scrim under text on a photo */
    content: ''; position: absolute; inset: 0;
    background:
      linear-gradient(180deg, rgb(20 10 8 / .7) 0%, rgb(20 10 8 / 0) 22%),
      linear-gradient(90deg, rgb(20 10 8 / .84) 0%, rgb(20 10 8 / .58) 46%, rgb(20 10 8 / 0) 78%);
  }
  .hero-copy { position: relative; padding-top: 120px; padding-bottom: 80px; max-width: 1040px; }
  .hero h1 { font-size: clamp(40px, 5.2vw, 78px); line-height: 1.05; text-transform: uppercase; letter-spacing: .02em; }
  .hero p { margin: 26px 0 38px; font-size: 20px; max-width: 34ch; color: #efe4d6; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 14px; }
  @media (max-width: 700px) {
    .hero { background-image: var(--bg-sm); background-position: 70% center; align-items: end; }
    .hero::before { background: linear-gradient(180deg, rgb(20 10 8 / .35) 0%, rgb(20 10 8 / .88) 62%); }
    .hero h1 { font-size: clamp(28px, 7.6vw, 34px); }
    .hero p { font-size: 17px; }
  }

  /* Practice areas */
  .areas { padding-block: var(--section-gap); }
  .cards { display: grid; grid-template-columns: repeat(4, 1fr); gap: 40px 24px; }
  .card > a:not(.button) { display: block; text-decoration: none; color: inherit; }
  .card-ph { overflow: hidden; }
  .card-ph img { width: 100%; height: auto; aspect-ratio: 4 / 5; object-fit: cover; transition: transform 700ms var(--ease-out); }
  .card h3 { font-size: 28px; color: var(--accent); margin: 18px 0 8px; }
  .card-items { color: var(--muted); line-height: 1.6; }
  @media (hover: hover) and (pointer: fine) {
    .card > a:not(.button):hover img { transform: scale(1.04); }
    .card > a:not(.button):hover h3 { text-decoration: underline; text-underline-offset: .18em; text-decoration-thickness: .06em; }
  }
  /* Full-width band under the cards: heading and note on the left, the action on the right. */
  .card-cta {
    grid-column: 1 / -1; background: var(--accent); color: var(--bg); padding: 30px 36px;
    display: grid; grid-template-columns: auto 1fr auto; gap: 8px 32px; align-items: center;
  }
  .card-cta h3 { color: var(--bg); font-size: 28px; margin: 0; }
  .card-cta p { color: #ecdccb; max-width: 60ch; }
  @media (max-width: 900px) {
    .card-cta { grid-template-columns: 1fr; justify-items: start; gap: 14px; }
  }
  @media (max-width: 1000px) { .cards { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 600px) {
    .cards { grid-template-columns: 1fr; }
    .sec-head { flex-direction: column; align-items: start; gap: 14px; margin-bottom: 36px; }
  }

  /* Band of panels */
  .band { display: flex; height: 68svh; min-height: 420px; }
  .panel {
    position: relative; flex: var(--grow) 1 0; min-width: 0; overflow: hidden; display: block;
    transition: flex-grow 500ms var(--ease-out); color: var(--bg); text-decoration: none;
  }
  .panel img { width: 100%; height: 100%; object-fit: cover; transition: transform 900ms var(--ease-out); }
  .panel::before { /* taste-skill-ignore: neutral scrim under text on a photo */
    content: ''; position: absolute; inset: 0 auto auto 0; width: 100%; height: 45%; z-index: 1;
    background: linear-gradient(to bottom, rgb(20 12 10 / .5), rgb(20 12 10 / 0)); pointer-events: none;
  }
  .panel-title { position: absolute; z-index: 2; left: 24px; top: 20px; font-size: var(--step-l); line-height: 1.05; max-width: 8ch; }
  @media (hover: hover) and (pointer: fine) {
    .panel:hover { flex-grow: 6; }
    .panel:hover img { transform: scale(1.03); }
  }
  .panel:focus-visible { outline-offset: -4px; outline-color: var(--bg); }
  .band-cap { margin-top: 18px; color: var(--muted); }
  @media (max-width: 700px) {
    .band { flex-wrap: wrap; height: 84svh; }
    .panel { flex: 0 0 auto; height: 50%; width: 36%; }
    .panel:nth-child(1), .panel:nth-child(4) { width: 64%; }
    .panel-title { left: 16px; top: 14px; font-size: 28px; }
  }

  /* Deadline calculator */
  .calc { padding-block: var(--section-gap); }
  .calc-in { display: grid; grid-template-columns: 1fr 1fr; }
  .calc-pick { background: var(--paper); padding: clamp(32px, 4vw, 60px); display: grid; align-content: start; }
  .calc-pick h2 { font-size: var(--step-l); color: var(--accent); }
  .calc-pick p { margin: 16px 0 30px; color: var(--muted); }
  .calc-pick label { font-weight: 500; margin-bottom: 8px; }
  .calc-pick select, .calc-pick input {
    font: 500 var(--step-body) var(--text); color: var(--ink); background: var(--bg);
    border: 0; border-radius: 0; min-height: 56px; padding: 0 16px; margin-bottom: 20px; width: 100%;
  }
  .calc-out {
    background: var(--accent); color: var(--bg); padding: clamp(32px, 4vw, 60px);
    display: flex; flex-direction: column; justify-content: center;
  }
  .calc-wd { color: #ecdccb; }
  .calc-big { font-size: var(--step-xl); margin: 10px 0 8px; }
  .calc-left {
    align-self: start; margin-top: 22px; padding: 14px 18px;
    background: #fdecea; color: #b3261e; font-weight: 600; border-left: 6px solid #b3261e;
  }
  .calc-left.calm { background: var(--bg); color: var(--accent); border-left-color: var(--surface); }
  .calc-law { margin-top: 28px; font-size: var(--step-s); color: #d9c5b4; max-width: 46ch; }
  @media (max-width: 800px) { .calc-in { grid-template-columns: 1fr; } }

  /* Contact */
  .contact { position: relative; background: #2a1410 var(--bg-c) center / cover no-repeat; color: var(--bg); }
  .contact::before { content: ''; position: absolute; inset: 0; background: rgb(32 10 8 / .74); }
  .contact-in {
    position: relative; padding-block: clamp(96px, 10vw, 140px);
    display: grid; grid-template-columns: 6fr 5fr; gap: clamp(40px, 6vw, 80px); align-items: center;
  }
  .contact .sec-title { color: var(--bg); }
  .contact-info > p { margin: 18px 0 34px; color: #ecdccb; max-width: 44ch; }
  .people { display: grid; grid-template-columns: 1fr 1fr; gap: 28px; margin-bottom: 30px; }
  .contact-person { display: grid; gap: 4px; align-content: start; justify-items: start; }
  .cp-name { font-size: 24px; line-height: 1.15; margin-bottom: 6px; }
  .contact-person a.link { text-decoration-color: transparent; overflow-wrap: anywhere; }
  .contact-person .button { margin-top: 12px; min-height: 44px; padding: 0 18px; font-size: var(--step-s); }
  .contact-addr { display: grid; gap: 2px; margin-bottom: 18px; }
  .contact-addr span { font-size: var(--step-s); color: #d9c5b4; }
  .contact-addr a { font: 600 24px/1.3 var(--display); text-decoration-color: transparent; }
  @media (max-width: 560px) { .people { grid-template-columns: 1fr; } }
  .cform { background: var(--bg); color: var(--ink); padding: clamp(28px, 3.4vw, 44px); display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .cform h3 { grid-column: 1 / -1; font-size: 28px; color: var(--accent); }
  .cform label { display: grid; gap: 6px; font-size: var(--step-s); font-weight: 500; }
  .cform .full { grid-column: 1 / -1; }
  .cform input:not([type='checkbox']), .cform textarea, .cform select {
    font: 400 var(--step-body) var(--text); color: var(--ink); background: var(--paper); border: 0; border-radius: 0; padding: 13px 14px; min-height: 48px;
  }
  .cform textarea { resize: vertical; }
  .cform .kvkk { display: flex; gap: 10px; align-items: start; font-weight: 400; color: var(--muted); }
  .cform .kvkk input { margin-top: 4px; accent-color: var(--accent); }
  .cform .button { justify-content: center; }
  .cform-note { color: var(--accent); font-size: var(--step-s); }
  .cform-hint { margin-top: -8px; color: var(--muted); font-size: var(--step-s); }
  .cform .trap { position: absolute; left: -9999px; width: 1px; height: 1px; opacity: 0; }
  .cform button:disabled { opacity: .7; cursor: progress; }
  @media (max-width: 900px) {
    .contact-in { grid-template-columns: 1fr; }
    .cform { grid-template-columns: 1fr; }
  }
</style>
